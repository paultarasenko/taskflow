# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- Security (Этап 5) ---
# Сгенерировать реальный секрет: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_ENV
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database (Этап 4) ---
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# --- Redis (Этап 4/8) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- AI (Этап 10) ---
AI_PROVIDER=openai
OPENAI_API_KEY=

# --- Frontend (Vite, Этап 9) ---
VITE_API_URL=http://localhost:8000/api/v1
